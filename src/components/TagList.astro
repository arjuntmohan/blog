---
interface Props {
	tags: string[];
}
const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>
					<a href={`/tags/${tag}/`}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		display: inline-block;
		padding: 0.3em 0.65em;
		border-radius: 6px;
		background: var(--green);
		color: var(--green-ink);
		font-family: var(--mono);
		font-size: 0.72rem;
		line-height: 1.2;
		text-decoration: none;
		transition: filter 0.15s;
	}
	a:hover {
		filter: brightness(0.96);
	}
</style>
