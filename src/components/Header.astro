---
import { SITE } from '../consts';

interface Props {
	/** Float over a banner with light text until the reader scrolls past it. */
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
	{ href: '/', label: 'Writing', active: path === '/' || path.startsWith('/blog') },
	{ href: '/tags/', label: 'Topics', active: path.startsWith('/tags') },
];
---

<header class:list={{ overlay }} data-header>
	<nav>
		<a class="name" href="/">{SITE.title}</a>
		<div class="right">
			<ul>
				{
					nav.map(({ href, label, active }) => (
						<li>
							<a href={href} aria-current={active ? 'page' : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
			{
				SITE.links.portfolio && (
					<a class="button ghost" href={SITE.links.portfolio}>
						<span class="arrow" aria-hidden="true">
							←
						</span>
						Portfolio
					</a>
				)
			}
			<a class="button" href="/about/">About me</a>
		</div>
	</nav>
</header>

{
	overlay && (
		<script is:inline>
			addEventListener('DOMContentLoaded', () => {
				const header = document.querySelector('[data-header]');
				const hero = document.querySelector('[data-hero]');
				const update = () =>
					header.classList.toggle('scrolled', !hero || scrollY > hero.offsetHeight - header.offsetHeight - 8);
				update();
				addEventListener('scroll', update, { passive: true });
			});
		</script>
	)
}

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		height: var(--header-h);
		background: rgba(245, 245, 242, 0.82);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid var(--line);
		transition:
			background 0.25s,
			border-color 0.25s,
			color 0.25s;
	}
	nav {
		height: 100%;
		max-width: var(--wide);
		margin: 0 auto;
		padding: 0 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.name {
		font-family: var(--serif);
		font-size: 1.6rem;
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 1.4rem;
	}
	.right .button + .button {
		margin-left: 0.5rem;
	}
	.arrow {
		font-size: 1em;
		line-height: 1;
	}
	ul {
		display: flex;
		gap: 1.3rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.92rem;
	}
	ul a {
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s;
	}
	ul a:hover,
	ul a[aria-current='page'] {
		color: var(--ink);
	}

	/* Over the banner: transparent, light text, light button. */
	header.overlay:not(.scrolled) {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border-color: transparent;
	}
	header.overlay:not(.scrolled) .name,
	header.overlay:not(.scrolled) ul a {
		color: rgba(255, 255, 255, 0.88);
		text-shadow: 0 1px 8px rgba(20, 50, 100, 0.3);
	}
	header.overlay:not(.scrolled) ul a:hover,
	header.overlay:not(.scrolled) ul a[aria-current='page'] {
		color: #fff;
	}
	header.overlay:not(.scrolled) .button {
		background: #fbfbf8;
		color: var(--ink);
	}
	header.overlay:not(.scrolled) .button.ghost {
		background: rgba(251, 251, 248, 0.16);
		border-color: rgba(255, 255, 255, 0.5);
		color: #fff;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	@media (max-width: 560px) {
		ul {
			display: none;
		}
		nav {
			padding: 0 0.9rem;
			gap: 0.5rem;
		}
		.name {
			font-size: 1.3rem;
		}
		.right {
			gap: 0.4rem;
		}
		.right .button {
			padding: 0.45em 0.6em;
			font-size: 0.78rem;
		}
		.right .button + .button {
			margin-left: 0;
		}
	}
	@media (max-width: 380px) {
		.arrow {
			display: none;
		}
	}
</style>

<style is:global>
	:root {
		--header-h: 4rem;
	}
</style>
