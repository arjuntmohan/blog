---
import { SITE } from '../consts';

interface Props {
	/** Float over a banner with light text until the reader scrolls past it. */
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
	{ href: '/', label: 'Writing', active: path === '/' || path.startsWith('/blog') },
	{ href: '/tags/', label: 'Topics', active: path.startsWith('/tags') },
	...(SITE.links.portfolio ? [{ href: SITE.links.portfolio, label: 'Portfolio', active: false }] : []),
];
---

<header class:list={{ overlay }} data-header>
	<nav>
		<a class="name" href="/">{SITE.title}</a>
		<div class="right">
			<ul>
				{
					nav.map(({ href, label, active }) => (
						<li>
							<a href={href} aria-current={active ? 'page' : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="button" href="/about/">About me</a>
		</div>
	</nav>
</header>

{
	overlay && (
		<script is:inline>
			addEventListener('DOMContentLoaded', () => {
				const header = document.querySelector('[data-header]');
				const hero = document.querySelector('[data-hero]');
				const update = () =>
					header.classList.toggle('scrolled', !hero || scrollY > hero.offsetHeight - header.offsetHeight - 8);
				update();
				addEventListener('scroll', update, { passive: true });
			});
		</script>
	)
}

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		height: var(--header-h);
		background: rgba(245, 245, 242, 0.82);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid var(--line);
		transition:
			background 0.25s,
			border-color 0.25s,
			color 0.25s;
	}
	nav {
		height: 100%;
		max-width: var(--wide);
		margin: 0 auto;
		padding: 0 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.name {
		font-family: var(--serif);
		font-size: 1.6rem;
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 1.4rem;
	}
	ul {
		display: flex;
		gap: 1.3rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.92rem;
	}
	ul a {
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s;
	}
	ul a:hover,
	ul a[aria-current='page'] {
		color: var(--ink);
	}

	/* Over the banner: transparent, light text, light button. */
	header.overlay:not(.scrolled) {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border-color: transparent;
	}
	header.overlay:not(.scrolled) .name,
	header.overlay:not(.scrolled) ul a {
		color: rgba(255, 255, 255, 0.88);
		text-shadow: 0 1px 8px rgba(20, 50, 100, 0.3);
	}
	header.overlay:not(.scrolled) ul a:hover,
	header.overlay:not(.scrolled) ul a[aria-current='page'] {
		color: #fff;
	}
	header.overlay:not(.scrolled) .button {
		background: #fbfbf8;
		color: var(--ink);
	}

	@media (max-width: 480px) {
		ul {
			display: none;
		}
	}
</style>

<style is:global>
	:root {
		--header-h: 4rem;
	}
</style>
