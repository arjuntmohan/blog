---
import type { Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
	/** Total number of posts, so each one keeps its issue number on filtered lists. */
	numberFrom?: Post[];
}
const { posts, numberFrom = posts } = Astro.props;
// Oldest post is No. 01.
const chronological = [...numberFrom].reverse();
const number = (post: Post) => String(chronological.indexOf(post) + 1).padStart(2, '0');
---

<ol class="posts">
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<span class="num">{number(post)}</span>
					<span class="body">
						<span class="title">{post.data.title}</span>
						<span class="description">{post.data.description}</span>
						<span class="meta">
							<FormattedDate date={post.data.pubDate} />
							{post.data.tags.length > 0 && <> · #{post.data.tags.join('  #')}</>}
							{post.data.draft && <span class="draft">Draft</span>}
						</span>
					</span>
					<span class="arrow" aria-hidden="true">
						→
					</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 14px;
		box-shadow: var(--shadow);
		overflow: hidden;
	}
	li + li {
		border-top: 1px solid var(--line);
	}
	a {
		display: grid;
		grid-template-columns: 2.5rem 1fr auto;
		gap: 0.75rem;
		align-items: start;
		padding: 1.35rem 1.4rem;
		text-decoration: none;
		color: var(--ink);
		transition: background 0.15s;
	}
	a:hover {
		background: var(--surface);
	}
	.num {
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--muted);
		padding-top: 0.3rem;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		min-width: 0;
	}
	.title {
		font-size: 1.2rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
	}
	.description {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.meta {
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
		margin-top: 0.3rem;
	}
	.draft {
		margin-left: 0.6em;
		padding: 0.15em 0.5em;
		border-radius: 5px;
		background: var(--peach);
		color: var(--peach-ink);
	}
	.arrow {
		color: var(--muted);
		padding-top: 0.15rem;
		transition:
			transform 0.15s,
			color 0.15s;
	}
	a:hover .arrow {
		color: var(--ink);
		transform: translateX(3px);
	}
	@media (max-width: 520px) {
		a {
			grid-template-columns: 2rem 1fr;
			padding: 1.1rem 1rem;
		}
		.arrow {
			display: none;
		}
	}
</style>
