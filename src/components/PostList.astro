---
import type { Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

<ol class="posts">
	{
		posts.map((post) => (
			<li>
				<p class="eyebrow">
					<FormattedDate date={post.data.pubDate} />
					{post.data.draft && <span class="draft">Draft</span>}
				</p>
				<h2>
					<a href={`/blog/${post.id}/`}>{post.data.title}</a>
				</h2>
				<p class="description">{post.data.description}</p>
				<TagList tags={post.data.tags} />
			</li>
		))
	}
</ol>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		padding: 1.9rem 0;
		border-top: 1px solid var(--line);
	}
	li:first-child {
		border-top: 0;
		padding-top: 0;
	}
	.eyebrow {
		margin: 0 0 0.35rem;
	}
	h2 {
		margin: 0 0 0.4rem;
		font-size: 1.55rem;
	}
	h2 a {
		color: var(--ink);
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--accent);
	}
	.description {
		margin: 0 0 0.7rem;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.55;
	}
	.draft {
		margin-left: 0.6em;
		padding: 0.1em 0.5em;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent);
	}
</style>
