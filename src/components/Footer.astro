---
import { SITE } from '../consts';

const { linkedin, github, email, portfolio } = SITE.links;
const links = [
	portfolio && { href: portfolio, label: 'Portfolio' },
	linkedin && { href: linkedin, label: 'LinkedIn' },
	github && { href: github, label: 'GitHub' },
	email && { href: `mailto:${email}`, label: 'Email' },
	{ href: '/rss.xml', label: 'RSS' },
].filter(Boolean) as { href: string; label: string }[];
---

<footer>
	<div class="inner">
		<div>
			<a class="name" href="/">{SITE.title}</a>
			<p class="eyebrow">© {new Date().getFullYear()} · Written by a human, one week at a time</p>
		</div>
		<ul>
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href}>{label}</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line);
		background: var(--surface);
	}
	.inner {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 2.5rem 1.25rem 3rem;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	.name {
		font-family: var(--serif);
		font-size: 1.5rem;
		color: var(--ink);
		text-decoration: none;
	}
	.eyebrow {
		margin: 0.4rem 0 0;
	}
	ul {
		display: flex;
		gap: 1.3rem;
		list-style: none;
		margin: 0.35rem 0 0;
		padding: 0;
		font-size: 0.92rem;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--ink);
	}
</style>
