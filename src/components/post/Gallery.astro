---
// A photo grid in reading order. Photos marked `wide` span the full width.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Photo {
	src: ImageMetadata;
	alt: string;
	wide?: boolean;
}
interface Props {
	label?: string;
	photos: Photo[];
}
const { label, photos } = Astro.props;
---

<figure class="gallery">
	{label && <figcaption class="eyebrow">{label}</figcaption>}
	<div class="grid">
		{
			photos.map((photo) => (
				<Image
					class:list={{ wide: photo.wide }}
					src={photo.src}
					alt={photo.alt}
					widths={[640, 960, 1400]}
					sizes="(max-width: 720px) 100vw, 56rem"
				/>
			))
		}
	</div>
</figure>

<style>
	.gallery {
		width: min(56rem, calc(100vw - 2.5rem));
		margin: 3rem 0;
		margin-left: 50%;
		transform: translateX(-50%);
	}
	figcaption {
		margin: 0 0 1rem;
		text-align: center;
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
	}
	.grid :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 12px;
		border: 1px solid var(--line);
		display: block;
	}
	.grid :global(img.wide) {
		grid-column: 1 / -1;
		height: auto;
	}
	@media (max-width: 560px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
