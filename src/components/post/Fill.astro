---
// A highlighted blank for the author to fill in. Only meant for drafts.
---

<mark class="fill"><slot /></mark>

<style>
	.fill {
		padding: 0.1em 0.35em;
		border-radius: 5px;
		background: #fff1b8;
		color: #6b5200;
		font-size: 0.92em;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	.fill::before {
		content: 'TO FILL IN → ';
		font-family: var(--mono);
		font-size: 0.7em;
		letter-spacing: 0.05em;
	}
</style>
