---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = Parameters<typeof BaseHead>[0] & {
	/** Page opens with a full-width banner (the `hero` slot) that the header floats over. */
	hero?: boolean;
};

const { hero = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...head} />
	</head>
	<body>
		<Header overlay={hero} />
		<slot name="hero" />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
