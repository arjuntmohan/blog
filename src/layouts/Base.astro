import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = Parameters<typeof BaseHead>[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...Astro.props} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
