---
import { Image } from 'astro:assets';
import Comments from '../components/Comments.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import type { Post } from '../lib/posts';
import { readingTime } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: Post;
	number: string;
	newer?: Post;
	older?: Post;
}

const { post, number, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, draft } = post.data;
---

<Base title={title} description={description} image={`/og/${post.id}.png`} type="article">
	<article>
		<header>
			<p class="eyebrow">
				No. {number} · <FormattedDate date={pubDate} /> · {readingTime(post.body)}
				{draft && <span class="draft">Draft · only visible to you</span>}
			</p>
			<h1>{title}</h1>
			<p class="dek">{description}</p>
			<TagList tags={tags} />
			{
				updatedDate && (
					<p class="eyebrow updated">
						Updated <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>
		{heroImage && <Image class="hero" width={1200} height={630} src={heroImage} alt="" />}
		<div class="content">
			<slot />
		</div>
	</article>

	<Comments />

	{
		(newer || older) && (
			<nav class="more" aria-label="More posts">
				{older && (
					<a href={`/blog/${older.id}/`}>
						<span class="eyebrow">← Previous</span>
						{older.data.title}
					</a>
				)}
				{newer && (
					<a class="next" href={`/blog/${newer.id}/`}>
						<span class="eyebrow">Next →</span>
						{newer.data.title}
					</a>
				)}
			</nav>
		)
	}
</Base>

<style>
	header {
		margin-bottom: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px dashed var(--line-strong);
	}
	header > .eyebrow {
		margin: 0 0 1.2rem;
	}
	h1 {
		margin-bottom: 0.9rem;
	}
	.dek {
		margin: 0 0 1.4rem;
		font-size: 1.2rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.updated {
		margin: 1rem 0 0;
	}
	.draft {
		margin-left: 0.6em;
		padding: 0.15em 0.5em;
		border-radius: 5px;
		background: var(--peach);
		color: var(--peach-ink);
	}
	.hero {
		width: 100%;
		margin-bottom: 3rem;
	}
	.content :global(h2) {
		font-size: 1.6rem;
	}
	.content :global(li) {
		margin-bottom: 0.4em;
	}
	.content :global(li::marker) {
		color: var(--muted);
	}
	.more {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 2rem;
	}
	.more a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.25rem;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 12px;
		color: var(--ink);
		text-decoration: none;
		line-height: 1.35;
		transition: box-shadow 0.15s;
	}
	.more a:hover {
		box-shadow: var(--shadow);
	}
	.more .next {
		grid-column: 2;
		text-align: right;
	}
</style>
