---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		// Posts are sorted newest first, so the previous index is the newer post.
		props: {
			post,
			number: String(posts.length - i).padStart(2, '0'),
			newer: posts[i - 1],
			older: posts[i + 1],
		},
	}));
}

interface Props {
	post: Post;
	number: string;
	newer?: Post;
	older?: Post;
}

const { post, number, newer, older } = Astro.props;
const { Content } = await render(post);
---

<BlogPost post={post} number={number} newer={newer} older={older}>
	<Content />
</BlogPost>
