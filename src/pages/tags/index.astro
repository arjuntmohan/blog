---
import Base from '../../layouts/Base.astro';
import { countTags, getPosts } from '../../lib/posts';

const tags = countTags(await getPosts());
---

<Base title="Topics" description="Every topic I've written about.">
	<p class="eyebrow">Browse</p>
	<h1>Topics <span class="soft">I keep coming back to.</span></h1>
	<ul>
		{
			tags.map(([tag, n]) => (
				<li>
					<a href={`/tags/${tag}/`}>#{tag}</a>
					<span class="eyebrow">
						{n} {n === 1 ? 'post' : 'posts'}
					</span>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.eyebrow {
		margin: 0 0 1rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 0;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 14px;
		box-shadow: var(--shadow);
		overflow: hidden;
	}
	li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 1rem 1.4rem;
	}
	li + li {
		border-top: 1px solid var(--line);
	}
	li .eyebrow {
		margin: 0;
	}
	a {
		color: var(--ink);
		text-decoration: none;
		font-size: 1.15rem;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
